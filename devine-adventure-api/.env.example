# .env.example

# ─── App ──────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────
# Local: same URL twice is fine.
# Supabase prod:
#   DATABASE_URL = transaction pooler :6543 + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = direct/session :5432 (used by prisma migrate)
DATABASE_URL=postgresql://devine:devine_pass@localhost:5432/devine_adventure
DIRECT_URL=postgresql://devine:devine_pass@localhost:5432/devine_adventure

# ─── JWT ──────────────────────────────────
JWT_ACCESS_SECRET=your_access_secret_min_32_chars_long_long_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_long_long_long
JWT_REFRESH_EXPIRES=7d

# ─── M-Pesa Daraja ────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://api.devineadventure.co.ke/payments/mpesa/callback
MPESA_ENVIRONMENT=sandbox   # sandbox | production

# ─── Stripe ───────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ─── Mailchimp ────────────────────────────
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_LIST_ID=

# ─── AWS S3 (image uploads) ───────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
AWS_S3_BUCKET=devine-adventure-media
